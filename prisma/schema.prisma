datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT") // 'STUDENT' | 'ADMIN'
  college   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases           Purchase[]
  sessions            UserSession[]
  devices             UserDevice[]
  deviceVerifications DeviceVerification[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  subCategories SubCategory[]
  notes         Note[]
}

model SubCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  categoryId  String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  notes    Note[]
}

model Note {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String   @db.Text
  price          Float
  originalPrice  Float?
  contentType    String   @default("PDF") // 'PDF' | 'TEXT'
  textContent    String?  @db.LongText   // Structured educational note text
  pdfUrl         String?  @db.Text       // Internal protected reference (optional for TEXT notes)
  categoryId     String
  subCategoryId  String
  thumbnail      String?  @db.Text
  author         String   @default("Topper Contributor")
  institute      String?
  pages          Int      @default(50)
  fileSize       String   @default("10 MB")
  sampleText     String?  @db.Text
  status         String   @default("ACTIVE") // 'ACTIVE' | 'DRAFT' | 'ARCHIVED'
  isBestseller   Boolean  @default(false)
  featured       Boolean  @default(false)
  salesCount     Int      @default(0)
  rating         Float    @default(4.8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category    Category    @relation(fields: [categoryId], references: [id])
  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])
  purchases   Purchase[]
}

model Purchase {
  id               String   @id @default(cuid())
  transactionId    String   @unique @default(cuid())
  studentId        String
  noteId           String
  amount           Float
  paymentStatus    String   @default("COMPLETED") // 'COMPLETED' | 'PENDING' | 'FAILED'
  paymentReference String
  paymentMethod    String   @default("Razorpay Online")
  purchasedAt      DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note    Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

// Persistent server-side session with rolling renewal and explicit revocation
model UserSession {
  id               String   @id @default(cuid())
  sessionToken     String   @unique @db.VarChar(255)
  userId           String
  deviceIdentifier String?  @db.VarChar(255)
  ipAddress        String?  @db.VarChar(100)
  userAgent        String?  @db.Text
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastActiveAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

// Student device tracking for rolling 48-hour login security
model UserDevice {
  id               String   @id @default(cuid())
  userId           String
  deviceIdentifier String   @db.VarChar(255)
  deviceName       String?  @db.VarChar(255)
  ipAddress        String?  @db.VarChar(100)
  userAgent        String?  @db.Text
  isVerified       Boolean  @default(false)
  firstSeenAt      DateTime @default(now())
  lastLoginAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdentifier])
  @@index([userId, firstSeenAt])
  @@index([userId, lastLoginAt])
}

// Secure single-use OTP verification codes for new device authorization
model DeviceVerification {
  id               String    @id @default(cuid())
  userId           String
  deviceIdentifier String    @db.VarChar(255)
  otpHash          String    @db.VarChar(255)
  attempts         Int       @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceIdentifier])
}
